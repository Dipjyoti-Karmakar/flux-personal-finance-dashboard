rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Receipts: only the owner can write; public read so PDFs open without auth tokens
    match /receipts/{userId}/{allPaths=**} {
      allow read: if true;                          // Public read — download URLs work for everyone
      allow write: if request.auth != null          // Must be logged in
                   && request.auth.uid == userId    // Can only write to own folder
                   && request.resource.size < 10 * 1024 * 1024  // 10 MB limit
                   && request.resource.contentType.matches('application/pdf|image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
